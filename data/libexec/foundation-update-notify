#!/usr/bin/python3 -I
"""Tell the desktop user that an installed update waits for a restart (run by foundation-update-notify.service)."""
import json
import shutil
import subprocess
import sys

PENDING = "/var/lib/foundation/update-pending.json"


def running_version():
    try:
        with open("/etc/os-release", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("IMAGE_VERSION="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def main():
    try:
        with open(PENDING, encoding="utf-8") as handle:
            version = str(json.load(handle).get("version", ""))
    except (OSError, ValueError):
        return 0                       # nothing waiting
    if version and version == running_version():
        return 0                       # already restarted into it
    program = shutil.which("notify-send")
    if not program:
        return 0
    body = "Restart to start using version " + version + "." if version else "Restart to finish updating."
    subprocess.run([program, "--app-name=Ersa Compute Platform", "--icon=system-software-update",
                    "--urgency=normal", "Update ready", body], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
