#!/usr/bin/python3 -I
"""The network came up: report this computer to the Ersa ID account it is linked to (Devices.CheckinOnline), so a name changed on the
website reaches it within seconds of its coming online.

Started by foundation-devices-online.service, which the NetworkManager hook (data/networkmanager/90-foundation-devices) starts when a
connection comes up or the internet becomes reachable, and only on a computer that is linked. foundationd decides whether to send:
at most once every fifteen minutes, and only if reporting is on. A service that cannot be reached yet (the name servers may not answer
the first second) is not counted, so the next event tries again. Nothing here can fail the unit: a problem is printed and that is all.
"""
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NAME = "org.ersa.Foundation1"
PATH = "/org/ersa/Foundation1"
DEVICES = NAME + ".Devices"


def main(argv):
    bus_type = Gio.BusType.SESSION if argv[1:] == ["--bus", "session"] else Gio.BusType.SYSTEM     # the session bus is for tests
    try:
        bus = Gio.bus_get_sync(bus_type, None)
        reply = bus.call_sync(NAME, PATH, DEVICES, "CheckinOnline", None, None, Gio.DBusCallFlags.NONE, 120_000, None)
        result = reply.unpack()[0].get("result", "")
    except GLib.Error as error:
        print(f"cannot report to the account: {error.message}")
        return 0
    print({"sent": "reported this computer's health to the account it is linked to"}.get(result, result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
