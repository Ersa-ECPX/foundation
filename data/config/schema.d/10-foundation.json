{
  "ota.url": {
    "type": "string",
    "default": "https://github.com/Ersa-ECPX/ecp-mkosi/releases/download/updates",
    "description": "Base URL of the OS image update source: the update window reads <url>/latest-<arch>.json there."
  },
  "ota.channel": {
    "type": "string",
    "default": "stable",
    "choices": ["stable", "testing"],
    "description": "Update channel."
  },
  "ota.auto_check": {
    "type": "boolean",
    "default": true,
    "description": "Check the update source periodically."
  },
  "ota.auto_download": {
    "type": "boolean",
    "default": false,
    "description": "Download updates without being asked."
  },
  "system.developer_mode": {
    "type": "boolean",
    "default": false,
    "description": "Enable developer features. Changing it requires administrator authentication."
  }
}
