msgid "On"
msgstr "இயக்கத்தில்"

#: foundation_deck/model.py:319
msgid "Give the user name."
msgstr "பயனர் பெயரைக் கொடுக்கவும்."

#: foundation_deck/model.py:322
msgid "Paste a public key (a line starting with ssh-ed25519, ssh-rsa and so on)."
msgstr "ஒரு பொது விசையை ஒட்டவும் (ssh-ed25519, ssh-rsa போன்றவற்றில் தொடங்கும் ஒரு வரி)."

#: foundation_deck/model.py:386
msgid "this file"
msgstr "இந்தக் கோப்பு"

#: foundation_deck/model.py:404 foundation_deck/model.py:63
